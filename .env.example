NEXT_PUBLIC_APP_NAME = "Kinora"
NEXT_PUBLIC_APP_DESCRIPTION = "A modern ecommerce store built with Next.js"
NEXT_PUBLIC_SERVER_URL = "http://localhost:3000"

DATABASE_URL =

AUTH_SECRET =
AUTH_TRUST_HOST =
SUPER_ADMIN_EMAIL =

ENCRYPTION_KEY = # Use a unique random secret of at least 32 characters

PAYMENT_METHODS = "PayPal,Stripe,SSLCOMMERZ,CashOnDelivery"
DEFAULT_PAYMENT_METHOD = "PayPal"

SSLCOMMERZ_STORE_ID =testbox
SSLCOMMERZ_STORE_PASSWORD =qwerty
SSLCOMMERZ_SANDBOX = "true"
# Override the default BDT amount for 1 USD (123); used for display and payments.
NEXT_PUBLIC_USD_TO_BDT_RATE = "123"

PAYPAL_API_URL =
PAYPAL_CLIENT_ID =
PAYPAL_APP_SECRET =

# Neon Object Storage: create this bucket with public_read access in the Neon Console.
AWS_ENDPOINT_URL_S3 =
AWS_ACCESS_KEY_ID =
AWS_SECRET_ACCESS_KEY =
AWS_REGION =
AWS_BUCKET_NAME = "product-images"

# Optional legacy UploadThing token; new direct image uploads use Neon Object Storage.
UPLOADTHING_TOKEN =

# Local shopping assistant (install/start Ollama, then run `ollama pull qwen2.5:3b`).
OLLAMA_BASE_URL = "http://127.0.0.1:11434"
OLLAMA_MODEL = "qwen2.5:3b"

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY =
STRIPE_SECRET_KEY =
STRIPE_WEBHOOK_SECRET =

RESEND_API_KEY =
SENDER_EMAIL = "npm.cmd run db:promote-super-admin"

NEXT_PUBLIC_TARGET_DATE = "2025-04-05T00:00:00"