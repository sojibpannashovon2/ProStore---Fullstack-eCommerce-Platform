// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model SellerPayoutCommission {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payoutId     String       @db.Uuid
  commissionId String       @unique @db.Uuid
  amount       Decimal      @db.Decimal(12, 2)
  payout       SellerPayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  commission   Commission   @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@index([payoutId], map: "SellerPayoutCommission_payoutId_idx")
}

model CartItem {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String          @db.Uuid
  userId    String?         @db.Uuid
  productId String          @db.Uuid
  variantId String?         @db.Uuid
  quantity  Int             @default(1)
  createdAt DateTime        @default(now()) @db.Timestamp(6)
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId], map: "CartItem_cartId_idx")
  @@index([userId, updatedAt], map: "CartItem_userId_updatedAt_idx")
  @@index([productId], map: "CartItem_productId_idx")
}

// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String?          @db.Uuid
  categoryId     String?          @db.Uuid
  brandId        String?          @db.Uuid
  name           String
  slug           String           @unique(map: "product_slug_idx")
  category       String
  images         String[]
  brand          String
  description    String
  stock          Int
  price          Decimal          @default(0) @db.Decimal(12, 2)
  rating         Decimal          @default(0) @db.Decimal(3, 2)
  numReviews     Int              @default(0)
  isFeatured     Boolean          @default(false)
  isApproved     Boolean          @default(true)
  isArchived     Boolean          @default(false)
  banner         String?
  createdAt      DateTime         @default(now()) @db.Timestamp(6)
  updatedAt      DateTime         @updatedAt
  OrderItem      OrderItem[]
  Review         Review[]
  seller         User?            @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  categoryRecord Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandRecord    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  productImages  ProductImage[]
  wishlistItems  WishlistItem[]
  cartItems      CartItem[]

  @@index([createdAt], map: "Product_createdAt_idx")
  @@index([isFeatured, createdAt], map: "Product_isFeatured_createdAt_idx")
  @@index([category, createdAt], map: "Product_category_createdAt_idx")
  @@index([price], map: "Product_price_idx")
  @@index([rating], map: "Product_rating_idx")
  @@index([sellerId, createdAt], map: "Product_sellerId_createdAt_idx")
  @@index([categoryId, createdAt], map: "Product_categoryId_createdAt_idx")
  @@index([brandId, createdAt], map: "Product_brandId_createdAt_idx")
  @@index([isApproved, createdAt], map: "Product_isApproved_createdAt_idx")
}

enum UserRole {
  super_admin
  admin
  seller
  customer
}

enum SellerApplicationStatus {
  pending
  approved
  rejected
}

enum SellerDocumentType {
  business_license
  government_id
  tax_document
}

enum SellerDocumentStatus {
  pending
  approved
  rejected
}

enum SellerOrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  partially_refunded
  refunded
}

enum RefundStatus {
  pending
  approved
  rejected
  processed
}

enum ShipmentStatus {
  pending
  shipped
  delivered
  returned
}

enum CouponDiscountType {
  percentage
  fixed
}

enum SellerPayoutStatus {
  pending
  paid
  cancelled
}

model User {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String              @default("NO_NAME")
  email                String              @unique(map: "user_email_idx")
  emailVerified        DateTime?           @db.Timestamp(6)
  image                String?
  password             String?
  role                 UserRole            @default(customer)
  address              Json?               @db.Json
  paymentMethod        String?
  createdAt            DateTime            @default(now()) @db.Timestamp(6)
  updatedAt            DateTime            @updatedAt
  account              Account[]
  session              Session[]
  Cart                 Cart[]
  Order                Order[]
  Review               Review[]
  products             Product[]           @relation("ProductSeller")
  sellerApplication    SellerApplication?  @relation("SellerApplicationOwner")
  reviewedApplications SellerApplication[] @relation("SellerApplicationReviewer")
  store                Store?              @relation("StoreSeller")
  sellerOrders         SellerOrder[]       @relation("SellerOrderSeller")
  addresses            UserAddress[]
  wishlist             Wishlist?
  cartItems            CartItem[]
  couponUsages         CouponUsage[]
  notifications        Notification[]
  payouts              SellerPayout[]      @relation("PayoutSeller")
  recordedPayouts      SellerPayout[]      @relation("PayoutRecorder")
  reviewedDocuments    SellerDocument[]    @relation("SellerDocumentReviewer")
  auditEvents          AuditLog[]          @relation("AuditActor")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         UserRole         @unique
  name        String
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamp(6)
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamp(6)
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "RolePermission_permissionId_idx")
}

model SellerApplication {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                  @unique @db.Uuid
  storeName       String
  description     String
  status          SellerApplicationStatus @default(pending)
  rejectionReason String?
  reviewedById    String?                 @db.Uuid
  submittedAt     DateTime                @default(now()) @db.Timestamp(6)
  reviewedAt      DateTime?               @db.Timestamp(6)
  user            User                    @relation("SellerApplicationOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?                   @relation("SellerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents       SellerDocument[]

  @@index([status, submittedAt], map: "SellerApplication_status_submittedAt_idx")
}

model SellerDocument {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId    String               @db.Uuid
  type             SellerDocumentType
  fileName         String
  contentType      String
  fileSize         Int
  encryptedContent Bytes                @db.ByteA
  encryptionIv     Bytes                @db.ByteA
  authTag          Bytes                @db.ByteA
  status           SellerDocumentStatus @default(pending)
  reviewedById     String?              @db.Uuid
  uploadedAt       DateTime             @default(now()) @db.Timestamp(6)
  reviewedAt       DateTime?            @db.Timestamp(6)
  application      SellerApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy       User?                @relation("SellerDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([applicationId, status], map: "SellerDocument_applicationId_status_idx")
}

model Store {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String   @unique @db.Uuid
  name        String
  slug        String   @unique
  description String
  logo        String?
  banner      String?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt
  seller      User     @relation("StoreSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([createdAt], map: "Store_createdAt_idx")
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Brand {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model ProductVariant {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String      @db.Uuid
  name       String
  sku        String      @unique
  attributes Json?       @db.Json
  price      Decimal?    @db.Decimal(12, 2)
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now()) @db.Timestamp(6)
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId], map: "ProductVariant_productId_idx")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position], map: "ProductImage_productId_position_idx")
}

model Inventory {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId String         @unique @db.Uuid
  quantity  Int            @default(0)
  updatedAt DateTime       @updatedAt
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model UserAddress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  fullName      String
  streetAddress String
  city          String
  postalCode    String
  country       String
  phone         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault], map: "UserAddress_userId_isDefault_idx")
}

model Wishlist {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @unique @db.Uuid
  createdAt DateTime       @default(now()) @db.Timestamp(6)
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId], map: "WishlistItem_productId_idx")
}

model SellerOrder {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String               @db.Uuid
  sellerId      String?              @db.Uuid
  status        SellerOrderStatus    @default(pending)
  itemsPrice    Decimal              @db.Decimal(12, 2)
  shippingPrice Decimal              @default(0) @db.Decimal(12, 2)
  createdAt     DateTime             @default(now()) @db.Timestamp(6)
  updatedAt     DateTime             @updatedAt
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller        User?                @relation("SellerOrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  shipment      Shipment?
  commission    Commission?
  statusHistory OrderStatusHistory[]

  @@index([sellerId, status, createdAt], map: "SellerOrder_sellerId_status_createdAt_idx")
  @@index([orderId], map: "SellerOrder_orderId_idx")
}

model OrderStatusHistory {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerOrderId String            @db.Uuid
  status        SellerOrderStatus
  note          String?
  createdAt     DateTime          @default(now()) @db.Timestamp(6)
  sellerOrder   SellerOrder       @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  @@index([sellerOrderId, createdAt], map: "OrderStatusHistory_sellerOrderId_createdAt_idx")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @db.Uuid
  provider          String
  providerReference String?       @unique
  idempotencyKey    String?       @unique
  status            PaymentStatus @default(pending)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String
  createdAt         DateTime      @default(now()) @db.Timestamp(6)
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([orderId, status], map: "Payment_orderId_status_idx")
}

model Refund {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String       @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  reason      String
  status      RefundStatus @default(pending)
  providerRef String?      @unique
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  updatedAt   DateTime     @updatedAt
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, status], map: "Refund_paymentId_status_idx")
}

model Shipment {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerOrderId String         @unique @db.Uuid
  provider      String?
  trackingCode  String?
  status        ShipmentStatus @default(pending)
  shippedAt     DateTime?      @db.Timestamp(6)
  deliveredAt   DateTime?      @db.Timestamp(6)
  createdAt     DateTime       @default(now()) @db.Timestamp(6)
  updatedAt     DateTime       @updatedAt
  sellerOrder   SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "Shipment_status_createdAt_idx")
}

model Coupon {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(12, 2)
  minimumAmount Decimal?           @db.Decimal(12, 2)
  usageLimit    Int?
  startsAt      DateTime?          @db.Timestamp(6)
  expiresAt     DateTime?          @db.Timestamp(6)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now()) @db.Timestamp(6)
  updatedAt     DateTime           @updatedAt
  usages        CouponUsage[]

  @@index([isActive, startsAt, expiresAt], map: "Coupon_isActive_startsAt_expiresAt_idx")
}

model CouponUsage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId  String   @db.Uuid
  userId    String   @db.Uuid
  orderId   String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId], map: "CouponUsage_couponId_userId_idx")
}

model Commission {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerOrderId    String                   @unique @db.Uuid
  rate             Decimal                  @db.Decimal(5, 2)
  grossAmount      Decimal                  @db.Decimal(12, 2)
  commissionAmount Decimal                  @db.Decimal(12, 2)
  sellerAmount     Decimal                  @db.Decimal(12, 2)
  createdAt        DateTime                 @default(now()) @db.Timestamp(6)
  sellerOrder      SellerOrder              @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  payouts          SellerPayoutCommission[]
}

model SellerPayout {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String                   @db.Uuid
  amount            Decimal                  @db.Decimal(12, 2)
  status            SellerPayoutStatus       @default(pending)
  externalReference String?
  recordedById      String?                  @db.Uuid
  notes             String?
  createdAt         DateTime                 @default(now()) @db.Timestamp(6)
  paidAt            DateTime?                @db.Timestamp(6)
  seller            User                     @relation("PayoutSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  recordedBy        User?                    @relation("PayoutRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  commissions       SellerPayoutCommission[]

  @@index([sellerId, status, createdAt], map: "SellerPayout_sellerId_status_createdAt_idx")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  title     String
  message   String
  readAt    DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt], map: "Notification_userId_readAt_createdAt_idx")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?
  metadata   Json?    @db.Json
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt], map: "AuditLog_actorId_createdAt_idx")
  @@index([targetType, targetId, createdAt], map: "AuditLog_targetType_targetId_createdAt_idx")
}

model SystemSetting {
  key       String   @id
  value     Json     @db.Json
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Cart {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?    @db.Uuid
  sessionCartId String
  items         Json[]     @default([]) @db.Json
  itemsPrice    Decimal    @db.Decimal(12, 2)
  totalPrice    Decimal    @db.Decimal(12, 2)
  discountPrice Decimal    @default(0) @db.Decimal(12, 2)
  couponCode    String?
  shippingPrice Decimal    @db.Decimal(12, 2)
  taxPrice      Decimal    @db.Decimal(12, 2)
  createdAt     DateTime   @default(now()) @db.Timestamp(6)
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]

  @@index([sessionCartId], map: "Cart_sessionCartId_idx")
  @@index([userId], map: "Cart_userId_idx")
}

model Order {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @db.Uuid
  shippingAddress Json          @db.Json
  paymentMethod   String
  paymentResult   Json?         @db.Json
  itemsPrice      Decimal       @db.Decimal(12, 2)
  shippingPrice   Decimal       @db.Decimal(12, 2)
  taxPrice        Decimal       @db.Decimal(12, 2)
  discountPrice   Decimal       @default(0) @db.Decimal(12, 2)
  couponCode      String?
  totalPrice      Decimal       @db.Decimal(12, 2)
  isPaid          Boolean       @default(false)
  paidAt          DateTime?     @db.Timestamp(6)
  isDelivered     Boolean       @default(false)
  deliveredAt     DateTime?     @db.Timestamp(6)
  createdAt       DateTime      @default(now()) @db.Timestamp(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderitems      OrderItem[]
  sellerOrders    SellerOrder[]
  payments        Payment[]
  couponUsages    CouponUsage[]

  @@index([createdAt], map: "Order_createdAt_idx")
  @@index([userId, createdAt], map: "Order_userId_createdAt_idx")
}

model OrderItem {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String          @db.Uuid
  sellerOrderId String?         @db.Uuid
  productId     String          @db.Uuid
  variantId     String?         @db.Uuid
  sku           String?
  qty           Int
  price         Decimal         @db.Decimal(12, 2)
  name          String
  slug          String
  image         String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sellerOrder   SellerOrder?    @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId, productId], map: "OrderItem_orderId_productId_idx")
  @@index([sellerOrderId], map: "OrderItem_sellerOrderId_idx")
  @@index([variantId], map: "OrderItem_variantId_idx")
  @@index([productId, orderId], map: "OrderItem_productId_orderId_idx")
}

model Review {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @db.Uuid
  productId          String   @db.Uuid
  rating             Int
  title              String
  description        String
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isApproved         Boolean  @default(true)

  @@index([productId, createdAt], map: "Review_productId_createdAt_idx")
}
